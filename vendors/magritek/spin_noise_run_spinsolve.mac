########################################################################
# spin_noise_run_spinsolve.mac
#
# spin-noise network acquisition orchestrator -- Magritek Spinsolve port
# (SpinsolveExpert automation script, Prospa macro language).
#
# *** STATUS: DRAFT PENDING BENCH VALIDATION -- HAS NEVER RUN ON A     ***
# *** SPINSOLVE. A documentation-verification pass (2026-08-26, see    ***
# *** the "Documentation verification log" in vendors/magritek/        ***
# *** README.md) checked every construct against Magritek's            ***
# *** SpinsolveExpert User Manual V1.41, the SpinsolveExpert Pulse     ***
# *** Programming Guide V1.40, Magritek's own autogenerated V5         ***
# *** experiment macros (SpinsolveExpert V2.02.27 output), and five    ***
# *** public repositories of real Prospa/SpinsolveExpert macros.       ***
# *** Constructs that documentation could not settle are marked        ***
# *** "UNVERIFIED(n)", where n is the item in the bench validation     ***
# *** checklist in README.md.                                          ***
#
# SHAPE: this is a SpinsolveExpert *automation script* in the shape the
# User Manual documents (section 4 "Automation using a script"): an
# entry procedure that adds the script to the experiment interface, an
# interface() procedure defining the operator-editable parameters, a
# getPlotInfo() stub, and a backdoor() procedure holding the run logic.
# Experiments are executed with the documented RunExpt(protocol,
# parameterList) command (User Manual section 4.1).
#
# PROTOCOL (identical block structure to the Bruker orchestrator
# topspin/spin_noise_run.py): operator parameters (the six questions,
# now UI fields) -> rxGain ladder -> small-flip reference -> N no-pulse
# noise acquisitions -> closing reference; every block saved to its own
# numbered folder under one session directory; answers.json written for
# the packer (vendors/magritek/magritek_reader.py) after every block,
# so a crash still leaves a packable session.
#
# Session directory layout produced (expno = folder name, packer relies
# on these numbers; keep in sync with magritek_reader.py):
#     <session>/answers.json
#     <session>/10, 14, 15, 16   rxGain ladder rungs
#     <session>/11               reference_open (small flip)
#     <session>/20 .. 20+N-1     noise blocks (NO PULSE)
#     <session>/13               reference_close (small flip)
#
# THE NOISE BLOCK (the point of the run) has two paths, selected by the
# useNoPulseSeq parameter:
#   "no" (default, runnable day one): the stock Proton experiment with
#        90Amplitude1H = -85. The Pulse Programming Guide (V1.40, p10)
#        documents -85 dB as "no power"; the residual excitation with
#        the 0.5 us minimum pulse length is ~1e-5 degrees of tip and is
#        RECORDED in answers.json as a built-in micro-reference (the
#        2022 attenuator lesson: never assume an attenuator is an off
#        switch -- log it, so the data says what actually happened).
#   "yes": a compiled experiment "SpinNoiseNoPulse" whose pulse program
#        contains NO pulse event at all. Create it at the bench with the
#        documented copy-and-edit flow (Pulse Programming Guide section
#        4: copy the Proton experiment files under the new name, edit
#        the pulse_program procedure, compile). The event list is:
#
#            initpp(dir)
#            wait(wPre)                      # settle delay
#            acquire("overwrite",nDataPnts)  # acquire only -- no pulse()
#            parList = endpp(0)
#
#        All five commands are documented (Guide, Appendix A). Whether
#        the compiler accepts an event list with no pulse() is
#        UNVERIFIED(3) -- that is the main thing the bench must try.
#
# Maintainer: John W. Blanchard, jwbquantum@gmail.com
# Co-developed with Claude (Anthropic).
########################################################################


########################################################################
# Entry point. Adds the script to the SpinsolveExpert experiment
# interface with default parameters.
#
# Pattern verbatim from a real Expert batch script (Thesis_mig40
# Chapter5_WaitTime_StopFlow.mac: gExpt->addExperiment with explicit
# ctrlLayout/plotLayout) and the User Manual section 4.1 script
# template. getmacropath()/getmacroname() as in Magritek's own
# autogenerated experiment macros.
########################################################################
procedure(spin_noise_run_spinsolve, parameters=null)

   if(parameters == null)
    # Defaults for unattended runs -- edit here or in the parameter
    # list the interface shows. String escaping (\") per the User
    # Manual's own script example ("saveData=\"false\"").
      parameters = ["facilitySlug = \"changeme-facility\"",
                    "institution = \"CHANGE ME\"",
                    "city = \"CHANGE ME\"",
                    "country = \"CHANGE ME\"",
                    "contactEmail = \"\"",
                    "contactConsent = \"no\"",
                    "sampleDesc = \"distilled water\"",
                    "h2oFractionPct = 100.0",
                    "d2oPct = 0.0",
                    "additives = \"none\"",
                    "tubeOD_mm = 5.0",
                    "sampleVol_ul = 550.0",
                    "sampleTemp_K = 300.0",
                    "lockState = \"unknown\"",
                    "nNoiseBlocks = 12",
                    "noisePnts = 65536",
                    "noiseDwell_us = 100",
                    "rxGainNoise_dB = 60",
                    "rxGainRef_dB = 20",
                    "refPnts = 16384",
                    "refDwell_us = 100",
                    "refPulse_deg = 5.0",
                    "useNoPulseSeq = \"no\"",
                    "sessionBase = \"C:/SpinNoiseNetwork\"",
                    "sessionTag = \"run1\""]
   endif

   (ctrlLayout, plotLayout) = :interface()
   gExpt->addExperiment(getmacropath(), getmacroname(), parameters,
                        ctrlLayout, plotLayout)

endproc()


########################################################################
# The parameter interface -- the six operator questions plus the run
# plan. Row format (name, label, control, datatype, info) follows the
# stock V5 interface lists (control types tb/tm/cb/dv and datatypes
# string/float/integer/ranges per Pulse Programming Guide V1.40 pp9-10).
# The gain / points / dwell menus reference the same model-specific
# menus the stock experiments use ($gData->rxGainMenu$ etc., verbatim
# from a real Spinsolve V2.02.27 interface file).
#
# UNVERIFIED(1): that a script ctrlLayout accepts this many rows and
# the dv dividers with this column convention -- the documented script
# example has a single 5-column row. Expect minutes of format fixing.
########################################################################
procedure(interface)

   ctrlLayout = ["",               "1: Facility",                   "dv", "",        "";
                 "facilitySlug",   "Facility slug (from maintainer)","tb", "string",  "";
                 "institution",    "Institution",                   "tb", "string",  "";
                 "city",           "City",                          "tb", "string",  "";
                 "country",        "Country",                       "tb", "string",  "";
                 "contactEmail",   "Contact email (optional)",      "tb", "string",  "";
                 "contactConsent", "Store contact email?",          "cb", "string",  "no,yes";
                 "",               "2: Sample",                     "dv", "",        "";
                 "sampleDesc",     "Sample description",            "tb", "string",  "";
                 "h2oFractionPct", "H2O fraction (%)",              "tb", "float",   "[0,100]";
                 "d2oPct",         "D2O fraction (%)",              "tb", "float",   "[0,100]";
                 "additives",      "Additives",                     "tb", "string",  "";
                 "tubeOD_mm",      "Tube OD (mm)",                  "tb", "float",   "[1,15]";
                 "sampleVol_ul",   "Sample volume (uL)",            "tb", "float",   "[10,5000]";
                 "",               "3: Temperature",                "dv", "",        "";
                 "sampleTemp_K",   "Magnet setpoint (K)",           "tb", "float",   "[250,350]";
                 "",               "4: Lock",                       "dv", "",        "";
                 "lockState",      "Lock during noise blocks",      "tm", "string",  "[\"unknown\",\"on\",\"off\"]";
                 "",               "5: Run plan",                   "dv", "",        "";
                 "nNoiseBlocks",   "Noise blocks",                  "tb", "integer", "[1,1000]";
                 "noisePnts",      "Noise points",                  "tm", "integer", "$gData->nrPntsMenu$";
                 "noiseDwell_us",  "Noise dwell time (us)",         "tm", "float",   "$gData->dwellTimeMenu$";
                 "rxGainNoise_dB", "Noise rx gain (dB)",            "tm", "integer", "$gData->rxGainMenu$";
                 "rxGainRef_dB",   "Reference rx gain (dB)",        "tm", "integer", "$gData->rxGainMenu$";
                 "refPnts",        "Reference points",              "tm", "integer", "$gData->nrPntsMenu$";
                 "refDwell_us",    "Reference dwell time (us)",     "tm", "float",   "$gData->dwellTimeMenu$";
                 "refPulse_deg",   "Reference tip (deg)",           "tb", "float",   "[1,20]";
                 "useNoPulseSeq",  "Use compiled SpinNoiseNoPulse?", "cb", "string",  "no,yes";
                 "",               "6: Session",                    "dv", "",        "";
                 "sessionBase",    "Session base folder",           "tb", "string",  "";
                 "sessionTag",     "Session tag (unique per run)",  "tb", "string",  ""]

   plotLayout = listto2d(["pt1"])

endproc(ctrlLayout, plotLayout)


########################################################################
# Plot-file bookkeeping stub (pattern verbatim from Magritek's own
# experiment macros). This script leaves plotting to the experiments it
# calls; the packer reads only acqu.par + data.1d.
########################################################################
procedure(getPlotInfo, plotRegion)

   info = ["pt1","fid.pt1"]

   if(plotRegion == "all")
      return(info)
   endif

   idx = getlistindex(info,plotRegion)
   if(idx != -1)
      return(info[idx+1])
   endif

endproc(null)


########################################################################
# The run itself. Called by SpinsolveExpert when the operator presses
# Run (documented flow: User Manual section 4.1 / Pulse Programming
# Guide section 5).
########################################################################
procedure(backdoor, parameters)

   version = "0.2.0-draft"
   assignstruct(parameters)

# ---------------------------------------------------------------------
# Calibrated 1H pulse from the spectrometer channel parameters, for the
# small-flip reference length. Pattern verbatim from a Magritek V5
# experiment macro (getFactoryBasedParameters: gData->
# getXChannelParameters("19F") -> PulseLength_19F). UNVERIFIED(8): the
# 1H key names (PulseLength_1H by analogy with the verified 19F ones).
# ---------------------------------------------------------------------
   specPar = gData->getXChannelParameters("1H")
   if(specPar == null)
      message("spin-noise run",
              "No 1H channel parameters found - is the system calibrated?",
              "error")
      return(0)
   endif
   assignlist(specPar)
   p90_us = PulseLength_1H                    # UNVERIFIED(8)

   refLen_us = p90_us*refPulse_deg/90.0
   if(refLen_us < 0.5)
      refLen_us = 0.5      # pulselength datatype floor (Guide V1.40 p10)
   endif
   refTipActual = 90.0*refLen_us/p90_us       # recorded in answers.json

# ---------------------------------------------------------------------
# Session directory. Created one level at a time (mkdir/cd pattern
# verbatim from CATonMOUSE.mac); try/catch absorbs "already exists".
# The tag makes reruns collide loudly rather than silently overwrite.
# UNVERIFIED(7): no documented Prospa wall-clock datetime-string
# command was found, so the session name carries an operator tag, not
# a timestamp; the bench session should look for one (help viewer /
# listcom) and upgrade this.
# ---------------------------------------------------------------------
   try; mkdir(sessionBase); catch; endtry
   cd(sessionBase)
   sessionName = "spinnoise_$facilitySlug$_$sessionTag$"
   try; mkdir(sessionName); catch; endtry
   cd(sessionName)
   session = getcwd()

# ---------------------------------------------------------------------
# Confirm before acquiring. query(title, text) returning "yes"/"no" is
# the form verified in real Prospa macros (CATonMOUSE.mac, twice).
# ---------------------------------------------------------------------
   txt = "spin-noise network run $version$\r"
   txt = txt + "facility: $facilitySlug$   sample: $sampleDesc$ (H2O $h2oFractionPct$%)\r"
   txt = txt + "noise blocks: $nNoiseBlocks$ x $noisePnts$ pts @ $noiseDwell_us$ us\r"
   txt = txt + "noise path: useNoPulseSeq = $useNoPulseSeq$\r"
   txt = txt + "session: $session$\r\r"
   txt = txt + "Fix anything wrong in the parameter list, then rerun.\r"
   txt = txt + "Continue?"
   r = query("spin-noise run", txt)
   if(r == "no")
      return(0)
   endif

# ---------------------------------------------------------------------
# Bookkeeping for answers.json. Block records accumulate in a single
# JSON string (string interpolation and concatenation only -- both
# verified constructs; no list-append construct was found in any
# public Prospa source, so none is used).
# ---------------------------------------------------------------------
   blocksJson = ""
   sep = ""
   b1 = 0.0
   swVer = "unknown"

# ---------------------------------------------------------------------
# 1) rxGain ladder: four small-flip 1Ds at increasing gain (receiver
#    linearity check, mirrors the Bruker RG ladder at expnos 10/14/15/16).
#    UNVERIFIED(4): snap these gains to this model's rxGain menu at the
#    bench (the menu is model-specific: $gData->rxGainMenu$).
# ---------------------------------------------------------------------
   ladderExpnos = [10, 14, 15, 16]
   ladderGains  = [0, 20, 40, 60]

   for(k = 0 to 3)
      g = ladderGains[k]
      e = ladderExpnos[k]
      t0 = round(time()*1000.0)             # UNVERIFIED(7): epoch of time()
      acqPar = :runBlock(session, e, "pulse", refLen_us, g,
                         refPnts, refDwell_us, useNoPulseSeq)
      t1 = round(time()*1000.0)
      if(k == 0)
       # Field names from a real acqu.par ("b1Freq", "softwareVersion" =
       # "2.02.27" style); guarded so a missing field cannot kill the run
       # (the packer prefers acqu.par values anyway).
         try; b1 = acqPar->b1Freq; catch; endtry
         try; swVer = acqPar->softwareVersion; catch; endtry
      endif
      blocksJson = "$blocksJson$$sep${\"expno\": $e$, \"role\": \"rg_ladder\", \"rx_gain_db\": $g$, \"wall_start_ms\": $t0$, \"wall_end_ms\": $t1$}"
      sep = ", "
      :writeAnswers(session, version, parameters, b1, swVer, p90_us,
                    refTipActual, blocksJson)
      if(wvExpStatus == "stop")
         return(0)
      endif
   next(k)

# ---------------------------------------------------------------------
# 2) opening reference: small-flip pulsed 1D (line position/width anchor)
# ---------------------------------------------------------------------
   t0 = round(time()*1000.0)
   acqPar = :runBlock(session, 11, "pulse", refLen_us, rxGainRef_dB,
                      refPnts, refDwell_us, useNoPulseSeq)
   t1 = round(time()*1000.0)
   blocksJson = "$blocksJson$$sep${\"expno\": 11, \"role\": \"reference_open\", \"rx_gain_db\": $rxGainRef_dB$, \"wall_start_ms\": $t0$, \"wall_end_ms\": $t1$}"
   sep = ", "
   :writeAnswers(session, version, parameters, b1, swVer, p90_us,
                 refTipActual, blocksJson)

# ---------------------------------------------------------------------
# 3) noise blocks: N acquisitions with NO PULSE, max stable gain.
#    THE POINT OF THE ENTIRE RUN. See :runBlock for the two paths.
# ---------------------------------------------------------------------
   for(b = 0 to nNoiseBlocks-1)
      e = 20 + b
      t0 = round(time()*1000.0)
      acqPar = :runBlock(session, e, "nopulse", 0.0, rxGainNoise_dB,
                         noisePnts, noiseDwell_us, useNoPulseSeq)
      t1 = round(time()*1000.0)
      blocksJson = "$blocksJson$$sep${\"expno\": $e$, \"role\": \"noise\", \"rx_gain_db\": $rxGainNoise_dB$, \"wall_start_ms\": $t0$, \"wall_end_ms\": $t1$}"
      sep = ", "
      :writeAnswers(session, version, parameters, b1, swVer, p90_us,
                    refTipActual, blocksJson)
      if(wvExpStatus == "stop")
         return(0)
      endif
   next(b)

# ---------------------------------------------------------------------
# 4) closing reference (drift check against the opening one)
# ---------------------------------------------------------------------
   t0 = round(time()*1000.0)
   acqPar = :runBlock(session, 13, "pulse", refLen_us, rxGainRef_dB,
                      refPnts, refDwell_us, useNoPulseSeq)
   t1 = round(time()*1000.0)
   blocksJson = "$blocksJson$$sep${\"expno\": 13, \"role\": \"reference_close\", \"rx_gain_db\": $rxGainRef_dB$, \"wall_start_ms\": $t0$, \"wall_end_ms\": $t1$}"
   :writeAnswers(session, version, parameters, b1, swVer, p90_us,
                 refTipActual, blocksJson)

   message("spin-noise run",
           "Done. Pack and upload from any Python 3 machine:\rpython3 vendors/magritek/magritek_reader.py pack $session$",
           "info")

endproc()


########################################################################
# runBlock(session, expno, mode, pulseLen_us, gain_dB, pnts, dwell_us,
#          useNoPulseSeq) -> acqPar
#
# Acquire one block with the documented RunExpt command (User Manual
# V1.41 section 4.1) and save it into <session>/<expno>/ as acqu.par +
# data.1d (the layout magritek_reader.py packs).
#
# RunExpt facts used (all from the manual's own script example):
#   - (result, acqPar) = RunExpt(protocol, ["name = value", ...])
#   - overridable parameters include nrPnts, repTime, nrScans,
#     dwellTime, pulseLength1H, saveData; unlisted parameters keep
#     their defaults. rxGain is a standard entry in every experiment's
#     parameter list (verified in a real V2.02.27 interface file), so
#     it is set the same way.
#   - result->tData is the time-domain data; acqPar is the acquisition
#     parameter structure (list(acqPar) = acqu.par-shaped string list).
#
# UNVERIFIED(2): RunExpt behavior with saveData="false" plus rxGain
# override, and that result->tData is the raw unprocessed FID.
# UNVERIFIED(3): the "SpinNoiseNoPulse" protocol only exists after the
# bench compiles it (header notes); until then useNoPulseSeq must be
# "no" (builtin -85 dB path).
# UNVERIFIED(6): save("acqu.par", list(acqPar)) completeness vs the
# framework-written acqu.par, and ucsFiles:saveMNovaData writing a 1D
# data.1d (the manual example writes "data.2d" from a matrix; same
# call, 1D vector, is the extrapolation to check -- run
# `magritek_reader.py inspect` on the result at the bench).
########################################################################
procedure(runBlock, session, expno, mode, pulseLen_us, gain_dB,
          pnts, dwell_us, useNoPulseSeq)

 # Repetition time must cover the acquisition (acqTime is ms).
   repMs = round(pnts*dwell_us/1000.0 + 1000)

   if(mode == "nopulse")
      if(useNoPulseSeq == "yes")
       # Path A: compiled acquire-only sequence (see header). UNVERIFIED(3)
         (result, acqPar) = RunExpt("SpinNoiseNoPulse",
               ["rxGain = $gain_dB$",
                "nrPnts = $pnts$",
                "dwellTime = $dwell_us$",
                "nrScans = 1",
                "repTime = $repMs$",
                "saveData = \"false\""])
      else
       # Path B (default): stock Proton with amplitude at -85 dB --
       # documented as "no power" (Guide V1.40 p10) -- and the minimum
       # 0.5 us length. Residual tip ~1e-5 deg; recorded in answers.json.
         (result, acqPar) = RunExpt("Proton",
               ["rxGain = $gain_dB$",
                "nrPnts = $pnts$",
                "dwellTime = $dwell_us$",
                "nrScans = 1",
                "repTime = $repMs$",
                "90Amplitude1H = -85",
                "pulseLength1H = 0.5",
                "saveData = \"false\""])
      endif
   else
    # Small-flip reference: stock Proton, calibrated amplitude, scaled
    # length (tip control via length at fixed amplitude).
      (result, acqPar) = RunExpt("Proton",
            ["rxGain = $gain_dB$",
             "nrPnts = $pnts$",
             "dwellTime = $dwell_us$",
             "nrScans = 1",
             "repTime = $repMs$",
             "pulseLength1H = $pulseLen_us$",
             "saveData = \"false\""])
   endif

 # Save into the packer's numbered layout (mkdir/cd/save pattern
 # verbatim from CATonMOUSE.mac; save() of a "key = value" string list
 # is the verified .par writer -- a real proc.par on disk matches the
 # macro list that wrote it).
   bak = getcwd()
   cd(session)
   try; mkdir("$expno$"); catch; endtry
   cd("$expno$")
   save("acqu.par", list(acqPar))                            # UNVERIFIED(6)
   ucsFiles:saveMNovaData(result->tData, "data.1d",
                          list(acqPar), "noReport")          # UNVERIFIED(6)
   cd(bak)

endproc(acqPar)


########################################################################
# writeAnswers -- write/overwrite <session>/answers.json for the packer.
#
# JSON is emitted as a list of strings saved with save(); one item per
# line. save("name.par", stringList) writing verbatim lines is verified
# against real on-disk output; UNVERIFIED(6): whether save() accepts a
# ".json" filename or dispatches on extension. If it refuses at the
# bench: save as answers.par with the same content and rename, or find
# the text-file writer in the Prospa help (help viewer, listcom).
# The packer treats EVERYTHING here as operator-entered data.
########################################################################
procedure(writeAnswers, session, version, parameters, b1, swVer,
          p90_us, refTipDeg, blocksJson)

   assignstruct(parameters)

 # The 2022 attenuator lesson: the noise path and any residual pulse
 # are logged explicitly, never assumed away.
   if(useNoPulseSeq == "yes")
      noiseMode = "custom-nopulse"
      noiseAmp  = "null"
      noiseLen  = "null"
   else
      noiseMode = "builtin-minamp"
      noiseAmp  = "-85"
      noiseLen  = "0.5"
   endif

   lines = ["{",
            "  \"writer\": \"spin_noise_run_spinsolve.mac $version$\",",
            "  \"facility_slug\": \"$facilitySlug$\",",
            "  \"institution\": \"$institution$\",",
            "  \"city\": \"$city$\",",
            "  \"country\": \"$country$\",",
            "  \"contact_email\": \"$contactEmail$\",",
            "  \"contact_consent\": \"$contactConsent$\",",
            "  \"sample_description\": \"$sampleDesc$\",",
            "  \"h2o_fraction_pct\": $h2oFractionPct$,",
            "  \"d2o_pct\": $d2oPct$,",
            "  \"additives\": \"$additives$\",",
            "  \"tube_od_mm\": $tubeOD_mm$,",
            "  \"sample_volume_ul\": $sampleVol_ul$,",
            "  \"vt_setpoint_k\": $sampleTemp_K$,",
            "  \"lock_state\": \"$lockState$\",",
            "  \"b1_freq_mhz\": $b1$,",
            "  \"p90_us\": $p90_us$,",
            "  \"ref_tip_deg\": $refTipDeg$,",
            "  \"spinsolve_software_version\": \"$swVer$\",",
            "  \"noise_pulse_mode\": \"$noiseMode$\",",
            "  \"noise_pulse_amp_db\": $noiseAmp$,",
            "  \"noise_pulse_len_us\": $noiseLen$,",
            "  \"blocks\": [$blocksJson$]",
            "}"]

   save("$session$/answers.json", lines)                     # UNVERIFIED(6)

endproc()
